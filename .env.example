VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_SERVICE_ROLE_KEY=
VITE_APP_URL=http://localhost:5173

# ── Mapbox (patient map — InteractiveMap.jsx) ───────────────────────────────
# Default public token from account.mapbox.com — free tier, no card required.
VITE_MAPBOX_ACCESS_TOKEN=pk....

# ── MercadoPago ───────────────────────────────────────────────────────────────
# false = sandbox (TEST- keys)  |  true = production (APP_USR- keys)
VITE_MP_IS_PROD=false
VITE_MP_PUBLIC_KEY_SANDBOX=TEST-...
VITE_MP_PUBLIC_KEY_PROD=APP_USR-...

# ── RCTA (Innovamed QBI2 — receta electrónica) ───────────────────────────────
# See website/docs/rcta-integration.md — also required as Supabase Edge Function secrets.
RCTA_API_URL=
RCTA_API_KEY=
RCTA_CLIENT_APP_ID=

# ── Sentry (error monitoring) ────────────────────────────────────────────────
# Org: healthier-yp, project: healthier-website. VITE_SENTRY_DSN is public by
# design. SENTRY_ORG/PROJECT/AUTH_TOKEN are build-time only, for
# @sentry/vite-plugin source map uploads — omit AUTH_TOKEN to skip uploads.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
SENTRY_ORG=healthier-yp
SENTRY_PROJECT=healthier-website
SENTRY_AUTH_TOKEN=
