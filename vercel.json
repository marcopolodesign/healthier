{
  "redirects": [
    { "source": "/compilance-argentina.html", "destination": "/privacidad", "permanent": true },
    { "source": "/compliance-argentina.html", "destination": "/privacidad", "permanent": true }
  ],
  "rewrites": [
    { "source": "/privacidad", "destination": "/privacidad.html" },
    { "source": "/privacidad/", "destination": "/privacidad.html" },
